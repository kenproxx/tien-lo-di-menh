{
  "name": "tien-lo-di-menh",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "pnpm --filter @tien-lo/client build && tsx scripts/build-client.ts && pnpm --filter @tien-lo/web build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/validate-content.ts",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "load:smoke": "tsx tests/load/smoke.ts",
    "lint": "tsc --noEmit",
    "admin": "tsx scripts/admin.ts",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,css}\" \"packages/*/src/**/*.{ts,json}\" scripts tests tsconfig.json vitest.config.ts playwright.config.ts"
  },
  "dependencies": {
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "pg": "8.16.3",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "@types/ws": "8.18.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
